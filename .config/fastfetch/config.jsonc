{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Shin-chan (suit) - monochrome fastfetch, kitty graphics protocol
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/shinchan_mono.png",   // use shinchan.png for the coloured version
    "width": 20,
    "preserveAspectRatio": true,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;235;235;235",
      "title": "1;38;2;255;255;255",
      "separator": "38;2;110;110;110",
      "output": "38;2;165;165;165"
    }
  },

  "modules": [
    { "type": "custom", "format": "\u001b[38;2;85;85;85m╭──────────────────────────────────╮" },
    { "type": "title", "key": "󰀄  User    ", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;85;85;85m├──────────────────────────────────┤" },
    { "type": "os",       "key": "󰣇  OS      " },
    { "type": "host",     "key": "󰌢  Host    " },
    { "type": "kernel",   "key": "󰌽  Kernel  " },
    { "type": "uptime",   "key": "󰅐  Uptime  " },
    { "type": "packages", "key": "󰏖  Pkgs    " },
    { "type": "shell",    "key": "󰆍  Shell   " },
    { "type": "wm",       "key": "󱂬  WM      " },
    { "type": "terminal", "key": "󰆍  Term    " },
    { "type": "display",  "key": "󰍹  Screen  " },
    { "type": "custom", "format": "\u001b[38;2;85;85;85m├──────────────────────────────────┤" },
    { "type": "cpu",      "key": "󰻠  CPU     ", "format": "{name}" },
    { "type": "gpu",      "key": "󰢮  GPU     ", "format": "{name}" },
    { "type": "memory",   "key": "󰍛  RAM     " },
    { "type": "disk",     "key": "󰋊  Disk    ", "folders": "/" },
    { "type": "battery",  "key": "󰁹  Battery ", "format": "{capacity}  [{status}]" },
    { "type": "custom", "format": "\u001b[38;2;85;85;85m╰──────────────────────────────────╯" },
    "break",
    { "type": "custom", "format": "  \u001b[38;2;28;28;28m▇▇\u001b[38;2;50;50;50m▇▇\u001b[38;2;72;72;72m▇▇\u001b[38;2;95;95;95m▇▇\u001b[38;2;120;120;120m▇▇\u001b[38;2;145;145;145m▇▇\u001b[38;2;170;170;170m▇▇\u001b[38;2;195;195;195m▇▇\u001b[38;2;220;220;220m▇▇\u001b[38;2;245;245;245m▇▇\u001b[0m" }
  ]
}
